{"kind":"cmd","task":"mini__pytest-dev__pytest-10051","seq":33,"phase":"solve","cmd":"sed -i '441,446c\\\n    def clear(self) -> None:\\\n        \"\"\"Reset the list of log records and the captured log text.\"\"\"\\\n        self.handler.reset()\\\n        # Update stash to point to the new records list after reset for current phase only\\\n        # Find the current phase by checking which phase has the same records as the handler had\\\n        for when, records in self._item.stash[caplog_records_key].items():\\\n            if records is not self.handler.records:  # Only update if it was pointing to the old records\\\n                self._item.stash[caplog_records_key][when] = self.handler.records\\\n                break' ./src/_pytest/logging.py","cwd":"/home/user/work/mini__pytest-dev__pytest-10051/repo","start_ns":1793855845449766082,"end_ns":1793855845454015822,"dur_s":0.0042496,"rc":0,"pre_snap":"33","venv":"/home/user/work/mini__pytest-dev__pytest-10051/venv"}
