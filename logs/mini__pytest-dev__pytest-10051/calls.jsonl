{"kind":"cmd","task":"mini__pytest-dev__pytest-10051","seq":31,"phase":"solve","cmd":"cat <<'EOF' > test_edge_cases.py\nimport logging\nimport pytest\n\n@pytest.fixture\ndef setup_logging(caplog):\n    caplog.set_level(\"INFO\")\n    logging.info(\"setup_message\")\n    yield\n    logging.info(\"teardown_message\")\n\ndef test_clear_with_multiple_phases(caplog, setup_logging):\n    \"\"\"Test that clear works correctly when there are records from multiple phases.\"\"\"\n    # At this point we should have setup records\n    setup_records = caplog.get_records(\"setup\")\n    assert len(setup_records) == 1\n    assert setup_records[0].getMessage() == \"setup_message\"\n    \n    # Add a call record\n    logging.info(\"call_message\")\n    call_records = caplog.get_records(\"call\")\n    assert len(call_records) == 1\n    assert call_records[0].getMessage() == \"call_message\"\n    \n    # Current records should only show call records\n    assert len(caplog.records) == 1\n    assert caplog.records[0].getMessage() == \"call_message\"\n    \n    # Clear should only affect current phase records\n    caplog.clear()\n    \n    # After clear, call records should be empty but setup records should remain\n    assert len(caplog.get_records(\"call\")) == 0\n    assert len(caplog.records) == 0\n    assert len(caplog.get_records(\"setup\")) == 1  # Setup records should still be there\n    \n    # Add another call record after clear\n    logging.info(\"call_message_after_clear\")\n    assert len(caplog.get_records(\"call\")) == 1\n    assert caplog.get_records(\"call\")[0].getMessage() == \"call_message_after_clear\"\n    assert len(caplog.records) == 1\n    assert caplog.records[0].getMessage() == \"call_message_after_clear\"\n\nif __name__ == \"__main__\":\n    import pytest\n    pytest.main([__file__, \"-v\"])\nEOF","cwd":"/home/user/work/mini__pytest-dev__pytest-10051/repo","start_ns":1793855845132051287,"end_ns":1793855845135943722,"dur_s":0.00389248,"rc":0,"pre_snap":"31","venv":"/home/user/work/mini__pytest-dev__pytest-10051/venv"}
