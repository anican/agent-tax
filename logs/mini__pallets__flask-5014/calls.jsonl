{"kind":"cmd","task":"mini__pallets__flask-5014","seq":17,"phase":"solve","cmd":"cat > test_blueprint_validation.py << 'EOF'\n#!/usr/bin/env python3\n\nimport sys\nimport os\n\n# Add the src directory to the path so we can import flask\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), 'src'))\n\nfrom flask import Blueprint\n\ndef test_empty_name_validation():\n    \"\"\"Test that creating a Blueprint with an empty name raises ValueError\"\"\"\n    try:\n        # This should raise a ValueError\n        bp = Blueprint(\"\", __name__)\n        print(\"ERROR: Blueprint with empty name was created successfully - this should not happen!\")\n        return False\n    except ValueError as e:\n        if \"Blueprint name cannot be empty\" in str(e):\n            print(\"SUCCESS: Blueprint with empty name correctly raised ValueError:\", str(e))\n            return True\n        else:\n            print(\"ERROR: ValueError raised but with wrong message:\", str(e))\n            return False\n    except Exception as e:\n        print(\"ERROR: Unexpected exception raised:\", type(e).__name__, str(e))\n        return False\n\ndef test_normal_name_still_works():\n    \"\"\"Test that creating a Blueprint with a normal name still works\"\"\"\n    try:\n        bp = Blueprint(\"test_blueprint\", __name__)\n        print(\"SUCCESS: Blueprint with normal name created successfully\")\n        return True\n    except Exception as e:\n        print(\"ERROR: Blueprint with normal name failed:\", type(e).__name__, str(e))\n        return False\n\ndef test_dot_validation_still_works():\n    \"\"\"Test that the existing dot validation still works\"\"\"\n    try:\n        bp = Blueprint(\"test.blueprint\", __name__)\n        print(\"ERROR: Blueprint with dot in name was created - this should not happen!\")\n        return False\n    except ValueError as e:\n        if \"may not contain a dot\" in str(e):\n            print(\"SUCCESS: Blueprint with dot in name correctly raised ValueError:\", str(e))\n            return True\n        else:\n            print(\"ERROR: ValueError raised but with wrong message:\", str(e))\n            return False\n    except Exception as e:\n        print(\"ERROR: Unexpected exception raised:\", type(e).__name__, str(e))\n        return False\n\nif __name__ == \"__main__\":\n    print(\"Testing Blueprint name validation...\")\n    \n    tests = [\n        test_empty_name_validation,\n        test_normal_name_still_works,\n        test_dot_validation_still_works\n    ]\n    \n    results = []\n    for test in tests:\n        print(f\"\\nRunning {test.__name__}...\")\n        results.append(test())\n    \n    print(f\"\\nResults: {sum(results)}/{len(results)} tests passed\")\n    \n    if all(results):\n        print(\"All tests passed!\")\n        sys.exit(0)\n    else:\n        print(\"Some tests failed!\")\n        sys.exit(1)\nEOF","cwd":"/home/user/work/mini__pallets__flask-5014/repo","start_ns":1793855859707696181,"end_ns":1793855859711823676,"dur_s":0.004127488,"rc":0,"pre_snap":"17","venv":"/home/user/work/mini__pallets__flask-5014/venv"}
