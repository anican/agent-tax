{"kind":"cmd","task":"mini__pytest-dev__pytest-10051","seq":34,"phase":"solve","cmd":"sed -i '441,449c\\\n    def clear(self) -> None:\\\n        \"\"\"Reset the list of log records and the captured log text.\"\"\"\\\n        old_records = self.handler.records\\\n        self.handler.reset()\\\n        # Update stash to point to the new records list after reset for the phase that was using the old records\\\n        for when, records in self._item.stash[caplog_records_key].items():\\\n            if records is old_records:\\\n                self._item.stash[caplog_records_key][when] = self.handler.records' ./src/_pytest/logging.py","cwd":"/home/user/work/mini__pytest-dev__pytest-10051/repo","start_ns":1793855845490977251,"end_ns":1793855845495010795,"dur_s":0.004033536,"rc":0,"pre_snap":"34","venv":"/home/user/work/mini__pytest-dev__pytest-10051/venv"}
