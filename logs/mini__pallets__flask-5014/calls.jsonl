{"kind":"cmd","task":"mini__pallets__flask-5014","seq":25,"phase":"solve","cmd":"cat > test_whitespace_edge.py << 'EOF'\n#!/usr/bin/env python3\n\nimport sys\nimport os\n\n# Add the src directory to the path so we can import flask\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), 'src'))\n\nfrom flask import Blueprint\n\ndef test_name_with_whitespace_around_valid_content():\n    \"\"\"Test that names with whitespace around valid content are rejected\"\"\"\n    test_cases = [\" valid_name \", \"  valid_name  \", \"\\tvalid_name\\n\"]\n    \n    for name in test_cases:\n        try:\n            bp = Blueprint(name, __name__)\n            # If we get here, the blueprint was created successfully\n            # This means the name was accepted, which might be okay\n            print(f\"INFO: Blueprint with name '{repr(name)}' was created successfully\")\n            print(f\"      Blueprint.name = '{repr(bp.name)}'\")\n        except ValueError as e:\n            print(f\"INFO: Blueprint with name '{repr(name)}' was rejected:\", str(e))\n        except Exception as e:\n            print(f\"ERROR: Unexpected exception for '{repr(name)}':\", type(e).__name__, str(e))\n            return False\n    \n    return True\n\nif __name__ == \"__main__\":\n    print(\"Testing Blueprint whitespace edge cases...\")\n    test_name_with_whitespace_around_valid_content()\nEOF","cwd":"/home/user/work/mini__pallets__flask-5014/repo","start_ns":1793855860612685175,"end_ns":1793855860616900430,"dur_s":0.00421504,"rc":0,"pre_snap":"25","venv":"/home/user/work/mini__pallets__flask-5014/venv"}
