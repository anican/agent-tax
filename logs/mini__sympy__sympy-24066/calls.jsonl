{"kind":"cmd","task":"mini__sympy__sympy-24066","seq":6,"phase":"solve","cmd":"cat <<'EOF' > reproduce_issue.py\nfrom sympy import exp\nfrom sympy.physics import units\nfrom sympy.physics.units.systems.si import SI\n\nprint(\"Testing the issue...\")\n\nexpr = units.second / (units.ohm * units.farad)\ndim = SI._collect_factor_and_dimension(expr)[1]\n\nprint(f\"Expression: {expr}\")\nprint(f\"Dimension: {dim}\")\nprint(f\"Is dimensionless: {SI.get_dimension_system().is_dimensionless(dim)}\")\n\nprint(\"\\nTesting buggy expression...\")\nbuggy_expr = 100 + exp(expr)\nprint(f\"Buggy expression: {buggy_expr}\")\n\ntry:\n    result = SI._collect_factor_and_dimension(buggy_expr)\n    print(f\"Result: {result}\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF","cwd":"/home/user/work/mini__sympy__sympy-24066/repo","start_ns":1793855854187609485,"end_ns":1793855854191473152,"dur_s":0.003863552,"rc":0,"pre_snap":"6","venv":"/home/user/work/mini__sympy__sympy-24066/venv"}
