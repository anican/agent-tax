{"kind":"cmd","task":"mini__psf__requests-5414","seq":32,"phase":"solve","cmd":"cat <<'EOF' > test_fix.py\nimport requests\nfrom requests.models import PreparedRequest\nfrom requests.exceptions import InvalidURL\n\n# Test the fix by directly calling prepare_url with problematic URLs\ntest_urls = [\n    \"http://.example.com\",\n    \"http://..example.com\", \n    \"http://example..com\",\n]\n\nprint(\"Testing the fix for UnicodeError -> InvalidURL conversion\")\n\nfor url in test_urls:\n    print(f\"\\nTesting URL: {url}\")\n    try:\n        req = PreparedRequest()\n        req.prepare_url(url, None)\n        print(\"  SUCCESS: URL preparation completed\")\n        print(f\"  Prepared URL: {req.url}\")\n    except InvalidURL as e:\n        print(f\"  CAUGHT InvalidURL (expected): {e}\")\n    except Exception as e:\n        print(f\"  CAUGHT OTHER EXCEPTION: {type(e).__name__}: {e}\")\n\n# Also test with a mock that forces UnicodeError\nprint(\"\\n\" + \"=\"*50)\nprint(\"Testing with forced UnicodeError simulation\")\n\n# Let's try to patch the parse_url function to raise UnicodeError\nimport unittest.mock\n\ndef mock_parse_url_unicode_error(url):\n    if '.example.com' in url:\n        raise UnicodeError(\"encoding with 'idna' codec failed (UnicodeError: label empty or too long)\")\n    # For other URLs, call the original function\n    from urllib3.util import parse_url as original_parse_url\n    return original_parse_url(url)\n\n# Patch parse_url to raise UnicodeError for our test case\nwith unittest.mock.patch('requests.models.parse_url', side_effect=mock_parse_url_unicode_error):\n    try:\n        req = PreparedRequest()\n        req.prepare_url(\"http://.example.com\", None)\n        print(\"  UNEXPECTED: URL preparation succeeded\")\n    except InvalidURL as e:\n        print(f\"  SUCCESS: Caught InvalidURL as expected: {e}\")\n    except UnicodeError as e:\n        print(f\"  FAILURE: UnicodeError not converted to InvalidURL: {e}\")\n    except Exception as e:\n        print(f\"  UNEXPECTED EXCEPTION: {type(e).__name__}: {e}\")\nEOF","cwd":"/home/user/work/mini__psf__requests-5414/repo","start_ns":1793707523756867932,"end_ns":1793707523765860201,"dur_s":0.008992256,"rc":0,"pre_snap":"32","venv":"/home/user/work/mini__psf__requests-5414/venv"}
