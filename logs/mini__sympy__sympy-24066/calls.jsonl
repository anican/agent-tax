{"kind":"cmd","task":"mini__sympy__sympy-24066","seq":28,"phase":"solve","cmd":"cat <<'EOF' > test_edge_cases.py\nfrom sympy import exp, sin, cos, log, tan, sinh, cosh\nfrom sympy.physics import units\nfrom sympy.physics.units.systems.si import SI\n\nprint(\"Testing edge cases...\")\n\n# Test with multiple arguments (though most of these functions are single-argument)\nexpr = units.second / (units.ohm * units.farad)\n\n# Test nested functions\ntry:\n    nested = exp(sin(expr))\n    result = SI._collect_factor_and_dimension(nested)\n    print(f\"exp(sin({expr})): SUCCESS - Result dimension: {result[1]}\")\nexcept Exception as e:\n    print(f\"exp(sin({expr})): ERROR - {e}\")\n\n# Test with complex expressions\ntry:\n    complex_expr = exp(expr) * sin(expr) + cos(expr)\n    result = SI._collect_factor_and_dimension(complex_expr)\n    print(f\"exp({expr}) * sin({expr}) + cos({expr}): SUCCESS - Result dimension: {result[1]}\")\nexcept Exception as e:\n    print(f\"Complex expression: ERROR - {e}\")\n\n# Test hyperbolic functions\ntry:\n    hyp_expr = sinh(expr) + cosh(expr)\n    result = SI._collect_factor_and_dimension(hyp_expr)\n    print(f\"sinh({expr}) + cosh({expr}): SUCCESS - Result dimension: {result[1]}\")\nexcept Exception as e:\n    print(f\"Hyperbolic functions: ERROR - {e}\")\n\nprint(\"All edge case tests completed!\")\nEOF","cwd":"/home/user/work/mini__sympy__sympy-24066/repo","start_ns":1793855857211957636,"end_ns":1793855857216890146,"dur_s":0.004932608,"rc":0,"pre_snap":"28","venv":"/home/user/work/mini__sympy__sympy-24066/venv"}
