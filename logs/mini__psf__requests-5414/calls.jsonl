{"kind":"cmd","task":"mini__psf__requests-5414","seq":37,"phase":"solve","cmd":"cat <<'EOF' > final_test.py\nimport requests\nfrom requests.models import PreparedRequest\nfrom requests.exceptions import InvalidURL\nimport unittest.mock\n\nprint(\"Final comprehensive test for UnicodeError -> InvalidURL fix\")\nprint(\"=\" * 60)\n\n# Test 1: Direct URL preparation (this is what the PR is about)\nprint(\"\\nTest 1: Direct URL preparation with problematic URLs\")\ntest_urls = [\"http://.example.com\", \"http://..example.com\", \"http://example..com\"]\n\nfor url in test_urls:\n    try:\n        req = PreparedRequest()\n        req.prepare_url(url, None)\n        print(f\"  {url}: SUCCESS (URL prepared: {req.url})\")\n    except InvalidURL as e:\n        print(f\"  {url}: InvalidURL (as expected): {e}\")\n    except Exception as e:\n        print(f\"  {url}: OTHER EXCEPTION: {type(e).__name__}: {e}\")\n\n# Test 2: Simulate the exact UnicodeError mentioned in the PR\nprint(\"\\nTest 2: Simulating UnicodeError from parse_url\")\ndef mock_parse_url_unicode_error(url):\n    if '.example.com' in url:\n        raise UnicodeError(\"encoding with 'idna' codec failed (UnicodeError: label empty or too long)\")\n    from urllib3.util import parse_url as original_parse_url\n    return original_parse_url(url)\n\nwith unittest.mock.patch('requests.models.parse_url', side_effect=mock_parse_url_unicode_error):\n    try:\n        req = PreparedRequest()\n        req.prepare_url(\"http://.example.com\", None)\n        print(\"  FAILURE: Should have raised InvalidURL\")\n    except InvalidURL as e:\n        print(f\"  SUCCESS: UnicodeError converted to InvalidURL: {e}\")\n    except UnicodeError as e:\n        print(f\"  FAILURE: UnicodeError not caught: {e}\")\n\n# Test 3: Simulate UnicodeError from requote_uri\nprint(\"\\nTest 3: Simulating UnicodeError from requote_uri\")\ndef mock_requote_uri_unicode_error(uri):\n    if '.example.com' in uri:\n        raise UnicodeError(\"Unicode error in URI requoting\")\n    from requests.utils import requote_uri as original_requote_uri\n    return original_requote_uri(uri)\n\nwith unittest.mock.patch('requests.models.requote_uri', side_effect=mock_requote_uri_unicode_error):\n    try:\n        req = PreparedRequest()\n        req.prepare_url(\"http://.example.com\", None)\n        print(\"  FAILURE: Should have raised InvalidURL\")\n    except InvalidURL as e:\n        print(f\"  SUCCESS: UnicodeError converted to InvalidURL: {e}\")\n    except UnicodeError as e:\n        print(f\"  FAILURE: UnicodeError not caught: {e}\")\n\nprint(\"\\n\" + \"=\" * 60)\nprint(\"All tests completed. The fix successfully converts UnicodeError to InvalidURL.\")\nEOF","cwd":"/home/user/work/mini__psf__requests-5414/repo","start_ns":1793707524870832927,"end_ns":1793707524879403369,"dur_s":0.008570624,"rc":0,"pre_snap":"37","venv":"/home/user/work/mini__psf__requests-5414/venv"}
